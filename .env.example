# Kikae — public build-time configuration (EXPO_PUBLIC_*).
# Copy this to `.env.local` (gitignored) for local development.
# These are NOT secrets; they are inlined into the bundle at build time.

EXPO_PUBLIC_AUTH_URL=https://dev.kikae.com.ng
EXPO_PUBLIC_API_URL=https://dev.kikae.com.ng/api
EXPO_PUBLIC_MEDIA_URL_PREFIX=https://file-dev.kikae.com.ng/
